 //----------------------- Pathfinder ---------------------------------------
 
+//----------------------- failed-search negative cache ---------------------------------------
+// WHY THIS IS EXACT. A search that fails ("exhausted the open list") is a pure function of: the request signature (start / goal cell, layers, locomotor surfaces, crusher, radius,
+// centre flag, human rules, ignored obstacle, downhill), the STATIC navigation data (cell type / obstacle / pinched / zone / layer / extents / the info-pool mode - every write to
+// them bumps PathfindCell::navigationVersion()), the hierarchical corridor flags of the request (digested), and the UNIT state of the footprint cells checkForMovement reads.
+// Moving units, unit goals and the transient cost terms do not decide feasibility (considerTransient is false in every search call site); only a stationary unit does. The cache stores
+// only failures during which NO footprint cell held a stationary unit, so unit state could only ever add blockers: with the static version, the corridor and the info-pool headroom
+// unchanged and no stationary unit in any footprint cell now, the closure the search explores, the cells it writes, the budget it adds and the "no path" result are the same
+// as before. The replay reproduces every persistent effect of the real search: m_cumulativeCellsAllocated (a serialised, CRC'd budget counter) and setBlockedByAlly(false) on every
+// cell it wrote, and releases the start and goal infos exactly like the failure tail. Anything unusual (tunnelling, dozers, layers, allocation failures, failover) is not recorded.
+// GENERALS_PATH_NEGCACHE=verify runs the real search on every replayable hit and compares the budget, the pool use, the written cells and the footprint (first difference: _exit(3)).
+static std::uint64_t negUnitState(const Object *obj, PathfindCell *cell);
+static inline std::uint8_t negDynWord(const PathfindCell *cell, const PathfindCell *start, const PathfindCell *goal);
+enum NegMode { NEG_OFF = 0, NEG_ON = 1, NEG_VERIFY = 2 };
+static NegMode currentNegMode()
+{
+	static const NegMode mode = [] {
+		const char *text = getenv("GENERALS_PATH_NEGCACHE");
+		if (!text || !*text) return NEG_ON;
+		if (text[0] == '0') return NEG_OFF;
+		if (text[0] == 'v' || text[0] == 'V') return NEG_VERIFY;
+		return NEG_ON;
+	}();
+	return mode;
+}
+static unsigned long long g_negHits = 0, g_negRecorded = 0, g_negVerified = 0, g_negMismatches = 0, g_negRejected = 0;
+static unsigned long long g_negWhy[3] = {0,0,0};
+static unsigned long long g_negFailures = 0, g_negIneligible = 0, g_negSkipUnit = 0, g_negSkipUnsafe = 0;
+const char *Pathfinder::negCacheModeName()
+{
+	switch (currentNegMode()) {
+		case NEG_OFF: return "OFF (every failed search runs)";
+		case NEG_VERIFY: return "VERIFY (replayable hits run the real search and are compared)";
+		default: return "default (proven-identical failed searches are replayed)";
+	}
+}
+unsigned long long Pathfinder::negCacheHits() { return g_negHits; }
+unsigned long long Pathfinder::negCacheRecorded() { return g_negRecorded; }
+unsigned long long Pathfinder::negCacheVerified() { return g_negVerified; }
+unsigned long long Pathfinder::negCacheMismatches() { return g_negMismatches; }
+unsigned long long Pathfinder::negCacheRejected() { return g_negRejected; }
+void Pathfinder::negCacheCounts(unsigned long long &failures, unsigned long long &ineligible, unsigned long long &skippedUnit, unsigned long long &skippedUnsafe) { failures = g_negFailures; ineligible = g_negIneligible; skippedUnit = g_negWhy[0] * 1000000000ull + g_negWhy[1] * 1000000ull + g_negWhy[2]; skippedUnsafe = g_negSkipUnsafe; }
+
+unsigned long long PathfindZoneManager::passableDigest()
+{
+	unsigned long long h = 1469598103934665603ull;
+	for (Int blockX = 0; blockX < m_zoneBlockExtent.x; blockX++) {
+		for (Int blockY = 0; blockY < m_zoneBlockExtent.y; blockY++) {
+			h ^= m_zoneBlocks[blockX][blockY].isPassable() ? 1u : 0u;
+			h *= 1099511628211ull;
+		}
+	}
+	return h;
+}
+
+void Pathfinder::negClear()
+{
+	m_negCache.clear();
+	m_negRec.active = false;
+	m_negRec.touched.clear();
+	m_negRec.footprint.clear();
+}
+
+void Pathfinder::negBegin()
+{
+	m_negRec.active = true;
+	m_negRec.unsafe = false;
+	m_negRec.unitSeen = false;
+	m_negRec.why = 0;
+	m_negLayerTouched.clear();
+	m_negLayerFootprint.clear();
+	m_negRec.touched.clear();
+	m_negRec.footprint.clear();
+	const size_t cells = static_cast<size_t>(m_extent.hi.x + 1) * static_cast<size_t>(m_extent.hi.y + 1);
+	if (m_negTouchedStamp.size() != cells) {
+		m_negTouchedStamp.assign(cells, 0);
+		m_negFootprintStamp.assign(cells, 0);
+		m_negGeneration = 0;
+	}
+	if (++m_negGeneration == 0) {
+		std::fill(m_negTouchedStamp.begin(), m_negTouchedStamp.end(), 0u);
+		std::fill(m_negFootprintStamp.begin(), m_negFootprintStamp.end(), 0u);
+		m_negGeneration = 1;
+	}
+}
+
+void Pathfinder::negNoteTouched(PathfindCell *cell, Int x, Int y)
+{
+	if (cell->getLayer() != LAYER_GROUND) {   // bridge / wall layer cells: few, deduplicated by address
+		if (m_negLayerTouched.insert(cell).second) m_negRec.touched.push_back(cell);
+		return;
+	}
+	if (x < 0 || y < 0 || x > m_extent.hi.x || y > m_extent.hi.y) { m_negRec.unsafe = true; m_negRec.why |= 4; return; }
+	UnsignedInt &stamp = m_negTouchedStamp[static_cast<size_t>(y) * static_cast<size_t>(m_extent.hi.x + 1) + static_cast<size_t>(x)];
+	if (stamp == m_negGeneration) return;
+	stamp = m_negGeneration;
+	m_negRec.touched.push_back(cell);
+}
+
+void Pathfinder::negNoteFootprint(PathfindCell *cell, Int x, Int y, PathfindLayerEnum layer)
+{
+	if (layer != LAYER_GROUND) {
+		if (m_negLayerFootprint.insert(cell).second) m_negRec.footprint.push_back(cell);
+		return;
+	}
+	if (x < 0 || y < 0 || x > m_extent.hi.x || y > m_extent.hi.y) { m_negRec.unsafe = true; m_negRec.why |= 4; return; }
