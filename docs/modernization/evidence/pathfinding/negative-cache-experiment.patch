+}
+
+Bool Pathfinder::negUnitStateMatches(const Object *obj, const PathNegCache::Entry<PathfindCell *> &entry, const PathfindCell *start, const PathfindCell *goal) const
+{
+	// Every footprint cell must still be in the state it was in (flags, info record, aircraft goal): a unit that moved into or out of the explored region changes both the
+	// cost order and what the exhausted pool let the search reach. The cells that hold units must also hold the same unit with the same decision from obj's point of view.
+	const size_t count = entry.footprint.size();
+	for (size_t i = 0; i < count; ++i) {
+		if (negDynWord(entry.footprint[i], start, goal) != entry.footprintDyn[i]) return false;
+	}
+	for (size_t i = 0; i < entry.fixedCells.size(); ++i) {
+		PathfindCell *cell = entry.fixedCells[i];
+		if (negUnitState(obj, cell) != entry.fixedState[i] || cell->getGoalUnit() != entry.fixedGoal[i]) return false;
+	}
+	return true;
+}
+
+// What the search decides about the unit state of a footprint cell, from the point of view of obj (a replica of checkForMovement's per-cell logic; kept next to it on purpose).
+// category: 0 = no effect, 1 = blocks, 2 = passable stationary ally (line walks stop; cost), 3 = stationary enemy that cannot be crushed, 4 = stationary enemy that can be crushed,
+// 5 = moving ally (cost near the start). The unit id is part of the value: another unit in the same cell is another state.
+static std::uint64_t negUnitState(const Object *obj, PathfindCell *cell)
+{
+	const ObjectID posUnit = cell->getPosUnit();
+	std::uint64_t category = 0;
+	const PathfindCell::CellFlags flags = cell->getFlags();
+	if (flags == PathfindCell::UNIT_PRESENT_FIXED || flags == PathfindCell::UNIT_PRESENT_MOVING || flags == PathfindCell::UNIT_GOAL_OTHER_MOVING) {
+		ObjectID ignoreId = INVALID_ID;
+		if (obj->getAIUpdateInterface()) ignoreId = obj->getAIUpdateInterface()->getIgnoredObstacleID();
+		if (posUnit != obj->getID() && posUnit != ignoreId) {
+			Object *unit = TheGameLogic->findObjectByID(posUnit);
+			if (unit) {
+				const bool ally = obj->getRelationship(unit) == ALLIES;
+				if (flags != PathfindCell::UNIT_PRESENT_FIXED) {
+					category = ally ? 5 : 0;
+				} else {
+					bool check = true;
+					if (obj->getAIUpdateInterface() && obj->getAIUpdateInterface()->getIgnoredObstacleID() == unit->getID()) check = false;
+#ifdef INFANTRY_MOVES_THROUGH_INFANTRY
+					if (check && obj->isKindOf(KINDOF_INFANTRY) && unit->isKindOf(KINDOF_INFANTRY)) check = false;
+#endif
+					if (check) {
+						if (ally) {
+							category = 2;
+							if (!unit->getAIUpdateInterface()) category = 1;
+#if RTS_GENERALS && RETAIL_COMPATIBLE_PATHFINDING
+							else if (!unit->getAIUpdateInterface()->isIdle()) category = 1;
+#endif
+						} else {
+							category = obj->canCrushOrSquish(unit, TEST_CRUSH_OR_SQUISH) ? 4 : 3;
+						}
+					}
+				}
+			}
+		}
+	}
+	return (static_cast<std::uint64_t>(posUnit) << 8) | category;
+}
+
+// The start and goal cells hold an info record only because the search itself allocated it (the tail releases it): their info bit is left out.
+static inline std::uint8_t negDynWord(const PathfindCell *cell, const PathfindCell *start, const PathfindCell *goal)
+{
+	return static_cast<std::uint8_t>(static_cast<unsigned>(cell->getFlags()) | ((cell->hasInfo() && cell != start && cell != goal) ? 16u : 0u) | (cell->isAircraftGoal() ? 32u : 0u));
+}
+
+static bool negFixedMode()
+{
+#if RETAIL_COMPATIBLE_PATHFINDING
+	return s_useFixedPathfinding != 0;
+#else
+	return true;
+#endif
+}
+
+[[noreturn]] static void negVerifyFail(const char *what, const Pathfinder *, Int sx, Int sy, Int gx, Int gy)
+{
+	++g_negMismatches;
+	printf("NEGCACHE VERIFY MISMATCH at frame %u, start (%d,%d) goal (%d,%d): %s\n", static_cast<unsigned>(TheGameLogic->getFrame()), sx, sy, gx, gy, what);
+	fflush(stdout);
+	_exit(3);
+}
